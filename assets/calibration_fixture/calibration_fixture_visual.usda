#usda 1.0
(
    defaultPrim = "Fixture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fixture"
{
    def "Looks"
    {
        def Material "MountGray"
        {
            token outputs:surface.connect = </Fixture/Looks/MountGray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.55)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "AprilTag"
        {
            token outputs:surface.connect = </Fixture/Looks/AprilTag/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:diffuseColor.connect = </Fixture/Looks/AprilTag/Texture.outputs:rgb>
                float inputs:roughness = 0.65
                token outputs:surface
            }

            def Shader "Primvar"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @apriltag36h11_id0_48mm_quietzone_600dpi.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Fixture/Looks/AprilTag/Primvar.outputs:result>
                float3 outputs:rgb
            }
        }
    }


        def MjcActuator "right_middle_MPR_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -0.12217304855585098, -0.003839724464341998, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [0.12217304855585098, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target

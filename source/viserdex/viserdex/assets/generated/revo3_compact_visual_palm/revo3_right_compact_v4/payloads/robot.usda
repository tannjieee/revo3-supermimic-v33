#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "revo3_single"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "revo3_single" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "right_middle_MPR_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_CMP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_index_MPR_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_MPR_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_MPR_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_middle_MCP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_middle_PIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_middle_DIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_CMR_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_MCP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_PIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_DIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_index_MCP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_index_PIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_index_DIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_MCP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_PIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_DIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_MCP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_PIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_DIP_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "world" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "right_middle_MPR_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_middle_MCP_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_middle_PIP_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_middle_DIP_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "right_thumb_CMP_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_thumb_CMR_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_thumb_MCP_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_thumb_PIP_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_thumb_DIP_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "right_index_MPR_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_index_MCP_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_index_PIP_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_index_DIP_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "right_ring_MPR_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_ring_MCP_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_ring_PIP_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_ring_DIP_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "right_little_MPR_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_little_MCP_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_little_PIP_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_little_DIP_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}


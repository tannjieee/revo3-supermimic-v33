#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "revo3_single"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "revo3_single"
{
    over "Physics"
    {
        over "right_middle_MPR_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
